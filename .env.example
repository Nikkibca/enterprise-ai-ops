# LLM Provider Configuration
# Set LLM_PROVIDER to "fake" for offline testing without paid API keys.
# Set LLM_PROVIDER to "openai" to use OpenAI API (requires OPENAI_API_KEY).
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PROJECT1_BASE_URL=http://127.0.0.1:8000

# Database Configuration
# Use 127.0.0.1 on Windows to prevent 120s IPv6 connection timeouts.
# Note: LangGraph checkpointing requires the standard postgresql:// URI format for psycopg.
# SQLAlchemy requires the postgresql+psycopg:// dialect prefix.
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://app_user:app_password@127.0.0.1:5433/enterprise_ai_ops
APP_DATABASE_URL=postgresql+psycopg://app_user:app_password@127.0.0.1:5433/enterprise_ai_ops
SQL_READER_DATABASE_URL=postgresql+psycopg://sql_reader:sql_reader_password@127.0.0.1:5433/enterprise_ai_ops

# Authentication Configuration
# JWT_SECRET_KEY must contain at least 32 characters in production.
JWT_SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-chars-long
JWT_ISSUER=enterprise-ai-ops
JWT_AUDIENCE=enterprise-ai-ops-api
JWT_ALGORITHM=HS256
